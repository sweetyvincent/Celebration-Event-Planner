{
  "name": "soiree-event-planner",
  "version": "4.0.0",
  "description": "Soir\u00e9e: a GenAI-powered celebration and event planner (static site, GitHub Pages ready).",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "python3 -m http.server 8000",
    "lint": "eslint .",
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.js\"",
    "test:all": "npm run lint && npm run format:check && npm run test:coverage && npm run test:e2e",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=util.js --test-coverage-include=plan-io.js --test-coverage-include=plan-logic.js --test-coverage-include=seating.js --test-coverage-include=engine.js --test-coverage-lines=95 --test-coverage-functions=95 --test-coverage-branches=85 \"tests/unit/*.test.js\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "npm audit --audit-level=high"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "axe-core": "^4.10.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "playwright-core": "~1.56.0",
    "prettier": "^3.3.0"
  },
  "engines": {
    "node": ">=22"
  }
}
